{
  "name": "bitepoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A focused browser racing simulation built for keyboard and mouse.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run api:typecheck && npm run api:build",
    "api:dev": "tsx watch server/main.ts",
    "api:typecheck": "tsc --noEmit -p tsconfig.api.json",
    "api:build": "tsup server/main.ts --format esm --target node22 --out-dir dist-api --clean",
    "api:start": "node dist-api/main.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
