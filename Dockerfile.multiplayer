FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run api:typecheck && npm run multiplayer:build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8788
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist-multiplayer ./dist-multiplayer
USER node
EXPOSE 8788
CMD ["node", "dist-multiplayer/multiplayer.js"]
