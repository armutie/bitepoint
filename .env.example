# Production browser configuration. Both values are safe to expose; never put
# a Supabase secret/service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional legacy/local Fastify API. Used only when Supabase is not configured.
VITE_LEADERBOARD_API=http://127.0.0.1:8787

# API process. Omit DATABASE_URL for temporary in-memory local development.
DATABASE_URL=postgres://bitepoint:password@localhost:5432/bitepoint
ALLOWED_ORIGINS=https://armutie.github.io,http://localhost:5173
PORT=8787
